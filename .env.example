ConnectionStrings__DefaultConnection=Host=your-host;Port=5432;Database=your-db;Username=your-user;Password=your-password;SSL Mode=Require;Trust Server Certificate=true
JwtSettings__SecretKey=replace-with-a-long-random-secret-at-least-32-bytes
JwtSettings__Issuer=BookIt.API
JwtSettings__Audience=BookIt.Client
JwtSettings__ExpiresInMinutes=60